#!/bin/sh
# Rejects direct pushes to main (DEC-038/DEC-039: second barrier behind branch protection).
# Enable once per clone: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are not allowed. Open a PR (ADR-015 §2)." >&2
    exit 1
  fi
done
exit 0
